<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="128dp" android:layout_height="192dp" android:layout_margin="8dp"
    android:focusable="true" android:clickable="true" android:clipToOutline="true"
    android:foreground="@drawable/focus_ring_poster">
    <TextView android:id="@+id/posterName" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:padding="12dp" android:textColor="@color/text_dim" android:textSize="13sp"
        android:fontFamily="@font/sora_semibold"/>
    <ImageView android:id="@+id/poster" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <TextView android:id="@+id/posterRating" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="8dp" android:textColor="#FFFFFF" android:textSize="11sp"
        android:fontFamily="@font/sora_bold" android:background="@drawable/live_pill" android:backgroundTint="#CC000000"
        android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
</FrameLayout>
