<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:focusable="true" android:clickable="true" android:paddingStart="8dp" android:paddingEnd="16dp">
    <TextView android:id="@+id/chNum" android:layout_width="30dp" android:layout_height="wrap_content"
        android:gravity="end" android:textColor="@color/text_faint" android:textSize="12sp"/>
    <FrameLayout android:id="@+id/chLogoBox" android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginStart="12dp">
        <ImageView android:id="@+id/chLogo" android:layout_width="30dp" android:layout_height="30dp"
            android:layout_gravity="center" android:scaleType="fitCenter"/>
        <TextView android:id="@+id/chMono" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:textSize="15sp" android:fontFamily="@font/sora_bold"
            android:includeFontPadding="false" android:visibility="gone"/>
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/chName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textColor="@color/text_dim" android:textSize="15sp"
            android:fontFamily="@font/sora_semibold"/>
        <TextView android:id="@+id/chNow" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="Now playing" android:textColor="@color/live" android:textSize="11sp"
            android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/chFav" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:text="♥" android:textColor="@color/live" android:textSize="13sp"
        android:visibility="gone"/>
</LinearLayout>
